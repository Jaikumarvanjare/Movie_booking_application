PORT=3000
NODE_ENV=development

DATABASE_URL=mongodb+srv://user:password@cluster.example.net/cinebook
AUTH_KEY=change_this_jwt_secret

# Full base URL of NotificationService, without trailing slash.
NOTI_SERVICE=http://localhost:3001

# Optional seed controls.
SEED_ADMIN=false
SEED_DEMO=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
DEMO_PASSWORD=change_this_demo_password

# Razorpay secrets stay on the backend only.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
